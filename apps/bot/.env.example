# Local development only. Gitignored — never commit this file.
# Production values live as Railway service variables.
# The durable copy of the token belongs in the shared password manager (see #2).

# Secret. The bot's token from the Discord developer portal.
# The application must have the Message Content intent enabled, or the sync
# refuses to run by design.
DISCORD_BOT_TOKEN=

# Not a secret — it appears in every deep link the Catalog publishes.
# Kept here for now because there is no config loader yet; it moves to
# committed config when the live adapter lands.
DISCORD_GUILD_ID=

# Secret. Any OpenAI-wire-compatible provider. OpenRouter is what is in use
# today because it fronts both DeepSeek and Kimi behind one key; a local model
# is this variable plus LLM_BASE_URL, and no code change.
# OPENROUTER_API_KEY is accepted as an alias.
LLM_API_KEY=

# Defaults to OpenRouter. Point it at a local server to keep everything in-house.
LLM_BASE_URL=

# Which model is strong and which is cheap is an experiment, not a decision.
# Strong runs one-time work that freezes something: the Topic vocabulary,
# identity summaries. Cheap runs steady state, which is most of the volume.
LLM_MODEL_STRONG=
LLM_MODEL_CHEAP=
