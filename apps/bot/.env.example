# Local development only. Gitignored — never commit this file.
# Production values live as Railway service variables.
# The durable copy of the token belongs in the shared password manager (see #2).

# Secret. The bot's token from the Discord developer portal.
# The application must have the Message Content intent enabled, or the sync
# refuses to run by design.
DISCORD_BOT_TOKEN=

# Not a secret — it appears in every deep link the Catalog publishes.
# Kept here for now because there is no config loader yet; it moves to
# committed config when the live adapter lands.
DISCORD_GUILD_ID=

# Secret. Any OpenAI-wire-compatible provider. OpenRouter is what is in use
# today because it fronts both DeepSeek and Kimi behind one key; a local model
# is this variable plus LLM_BASE_URL, and no code change.
# OPENROUTER_API_KEY is accepted as an alias.
LLM_API_KEY=

# Defaults to OpenRouter. Point it at a local server to keep everything in-house.
LLM_BASE_URL=

# Which model is strong and which is cheap is an experiment, not a decision.
# Strong runs one-time work that freezes something: the Topic vocabulary,
# identity summaries. Cheap runs steady state, which is most of the volume.
#
# Benchmarked 2026-09-03 on the real vocabulary derivation (117 catalog entries
# in, ~20 tags out), which is the heaviest prompt in the project:
#   deepseek/deepseek-v4-flash  four parallel runs in ~80s, valid JSON every
#                               time. The only candidate that completed the
#                               whole pipeline.
#   qwen/qwen3.7-flash          cheapest on paper, but returned `{}` twice
#                               through the retry. Unusable here.
#   z-ai/glm-5.3-flash          never returned inside 15 minutes.
#   moonshotai/kimi-k2.6        timed out, and ~11x the input price. Dropped.
#
# **DeepSeek for both roles, pinned, until quality is measurably short.**
# Decided 2026-09-04. Splitting strong from cheap stays supported in code and
# costs nothing to reintroduce; there is just no measurement that asks for it.
#   deepseek/deepseek-v4-flash-0731   $0.065/M in, $0.18/M out, 1.3M context
LLM_MODEL_STRONG=
LLM_MODEL_CHEAP=

# Optional, and an override rather than a tuning knob: setting it applies one
# number to every job, including the ones that size their own.
#
# The default is 180s, which suits the per-Entity passes — they answer in
# seconds, and a short leash is what gets a hung call retried onto a healthy
# provider instead of blocking. The vocabulary bootstrap sets its own 420s,
# because a single derivation was measured at 205s answering correctly and the
# default was aborting work that would have succeeded. One number does not
# serve both, which is why raising this globally is the wrong lever.
LLM_TIMEOUT_MS=

# Optional, vendor-specific, passed through verbatim and omitted when unset.
#
# **Pinning a model does not pin who serves it, and the provider is the
# variable that matters.** Measured 2026-09-04: the same prompt to the same
# pinned model, five times, took 11s, 47s, 58s, 106s and 205s — a 20x spread
# tracking which provider OpenRouter chose, with output from 48 to 5,710
# tokens. The 11s call was a *truncated* answer, so fast was not good either.
# Every hang and every empty `{}` seen while building the Phase 2 passes traces
# to this, not to the model.
#
#   LLM_PROVIDER={"sort":"throughput"}                       fastest available
#   LLM_PROVIDER={"order":["DeepSeek"],"allow_fallbacks":false}   one provider
LLM_PROVIDER=
