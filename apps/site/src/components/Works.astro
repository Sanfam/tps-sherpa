---
// The `works` entries a club page references, in the order its editor set:
// cover, title, creators and kind. Every cover sits whole in the same frame,
// on a filler toned from the cover itself; a work with none shows its title
// there instead, so the grid stays even.
import { getTermsForEntries } from "emdash";
import { safeHref } from "../safe-href.ts";
import MediaImage from "./MediaImage.astro";

type Work = { id: string; data: Record<string, unknown> };
interface Props {
  works: Work[];
}

const { works } = Astro.props;
// Referenced entries come back without their terms. Terms key on the database id.
const dbId = (w: Work) => String(w.data["id"] ?? w.id);
const kinds = await getTermsForEntries("works", works.map(dbId), "work_kind");
const text = (w: Work, field: string) => (typeof w.data[field] === "string" ? (w.data[field] as string) : undefined);
---
<ul class="works">
  {
    works.map((w) => {
      const link = safeHref(w.data["link"]);
      const title = text(w, "title");
      return (
        <li>
          <div class="cover">
            {w.data["cover"] ? (
              <MediaImage image={w.data["cover"] as never} />
            ) : (
              <span class="cover-title" aria-hidden="true">{title}</span>
            )}
          </div>
          <p class="work-title">{link ? <a href={link}>{title}</a> : title}</p>
          {text(w, "creators") && <p>{text(w, "creators")}</p>}
          {kinds.get(dbId(w))?.map((k) => <p class="work-kind">{k.label}</p>)}
        </li>
      );
    })
  }
</ul>
<script>
  // The frame's filler: the cover's average colour, pulled toward grey so it
  // sits behind the cover rather than competing with it. Covers come from the
  // site's own origin, so the canvas can read them; any failure keeps the
  // theme's neutral filler.
  const tone = (img: HTMLImageElement) => {
    try {
      const c = document.createElement("canvas");
      c.width = c.height = 1;
      const ctx = c.getContext("2d", { willReadFrequently: true })!;
      ctx.drawImage(img, 0, 0, 1, 1);
      const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
      const grey = (r! + g! + b!) / 3;
      const mute = (v: number) => Math.round(v * 0.55 + grey * 0.45);
      img.closest<HTMLElement>(".cover")!.style.backgroundColor = `rgb(${mute(r!)} ${mute(g!)} ${mute(b!)})`;
    } catch {}
  };
  for (const img of document.querySelectorAll<HTMLImageElement>(".works .cover img")) {
    if (img.complete && img.naturalWidth) tone(img);
    else img.addEventListener("load", () => tone(img), { once: true });
  }
</script>
<style>
  .works {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.5rem 1.25rem;
  }

  .works li + li {
    margin-top: 0;
  }

  .works p {
    margin: 0.35em 0 0;
    font-size: 0.9375rem;
  }

  .cover {
    aspect-ratio: 2 / 3;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: var(--radius);
    border: 4px solid var(--paper);
    box-shadow: var(--lift);
    background: var(--ground-raised);
  }

  .cover :global(a) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: none;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .cover-title {
    padding: 0.75rem;
    text-align: center;
    font-family: var(--display);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .work-title {
    font-weight: 700;
  }

  .work-kind {
    color: var(--ink-soft);
  }
</style>
