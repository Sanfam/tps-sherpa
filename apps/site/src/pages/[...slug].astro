---
// A published `pages` entry at its slug, which keeps the old wiki path
// (`parenting/child/home` at /parenting/child/home). Anything else is a 404,
// drafts and the import's stub pages included, except to an editor in edit
// mode. Member-gated by the middleware, so it must stay server-rendered.
import { getEditMeta, getEmDashEntry } from "emdash";
import { getRequestContext, runWithContext } from "emdash/request-context";
import { PortableText } from "emdash/ui";
import Heading from "../components/Heading.astro";
import MediaImage from "../components/MediaImage.astro";
import UpcomingEvents from "../components/UpcomingEvents.astro";
import Works from "../components/Works.astro";
import { clubs } from "../events.ts";
import { withHeadingAnchors } from "../heading-ids.ts";
import Base from "../layouts/Base.astro";
import { childrenOf, placeOf, publishedPages, trail } from "../nav.ts";

// Edit mode is EmDash's: drafts and inline editing for an editor who turned it
// on, judged on the role EmDash stored, which a Discord role loss leaves in
// place (accepted, ADR-0002 item 1). Saves go through the gate on the live role.
// Preview tokens stay off (issue #120).
// ponytail: one page of up to 100 works, EmDash's most; follow nextCursor if a club lists more.
const { entry, error } = await runWithContext({ ...getRequestContext(), preview: undefined }, () =>
  getEmDashEntry("pages", Astro.params.slug ?? "", { references: { works: { limit: 100 } } }),
);
if (error) throw error;
if (!entry) Astro.response.status = 404;
const works = entry?.references?.["works"]?.entries ?? [];
// Its way up and its published pages below it (src/nav.ts).
const pages = await publishedPages();
const place = entry ? placeOf(entry.id) : "";
const up = entry ? trail(pages, place) : [];
const below = entry ? childrenOf(pages, place) : [];
// A club's page (content/config/clubs.json) lists its next events.
const club = entry ? clubs.find((c) => c.page === place) : undefined;
---
{
  entry ? (
    <Base title={String(entry.data["title"])} members>
      <div class="wrap prose">
        {up.length > 0 && (
          <nav aria-label="Breadcrumb">
            <ol class="crumbs">
              {up.map((p) => <li><a href={pages.get(p)!.href}>{pages.get(p)!.title}</a></li>)}
            </ol>
          </nav>
        )}
        <h1 {...entry.edit.title}>{String(entry.data["title"])}</h1>
        {/* In edit mode the content carries EmDash's marker for its inline editor, which a copy would drop.
            That editor renders headings itself, without anchors: a #fragment lands only outside edit mode. */}
        <PortableText value={(getEditMeta(entry.data["content"]) ? entry.data["content"] : withHeadingAnchors(entry.data["content"])) as never} components={{ block: Heading, type: { image: MediaImage, gallery: MediaImage } }} />
        {club && <UpcomingEvents club={club} />}
        {works.length > 0 && <Works works={works} />}
        {below.length > 0 && (
          <nav aria-labelledby="in-this-section">
            <h2 id="in-this-section">In this section</h2>
            <ul>
              {below.map((p) => <li><a href={pages.get(p)!.href}>{pages.get(p)!.title}</a></li>)}
            </ul>
          </nav>
        )}
      </div>
    </Base>
  ) : (
    <Base title="Not found" members>
      <div class="wrap prose">
        <h1>Not here yet</h1>
        <p>This page has not been written, or has moved.</p>
      </div>
    </Base>
  )
}
