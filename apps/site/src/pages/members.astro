---
// Where sign-in lands: the way into the CMS's sections and the Index. Must stay
// server-rendered: the middleware is the gate.
import Base from "../layouts/Base.astro";
import { publishedPages, sections } from "../nav.ts";

const pages = await publishedPages();
---
<Base title="Members" members>
  <div class="wrap prose">
    <h1>Members only</h1>
    <ul>
      {sections(pages).map((p) => <li><a href={pages.get(p)!.href}>{pages.get(p)!.title}</a></li>)}
      <li><a href="/index">Index</a>: the Channels, Forums and Posts on the server</li>
    </ul>
  </div>
</Base>
